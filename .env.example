# Copy this file to .env with: data-agent llm init
# Never commit .env or share its API key.

# Base resource endpoint from Azure "Keys and Endpoint".
# Do not append /openai/deployments/... to this value.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/

# A key for the same Azure OpenAI resource.
AZURE_OPENAI_API_KEY=YOUR_KEY

# key or entra. Use entra when local/key authentication is disabled by policy.
AZURE_OPENAI_AUTH_MODE=key
# Optional tenant ID. Leave blank to select the tenant during browser sign-in.
AZURE_OPENAI_TENANT_ID=
AZURE_OPENAI_TOKEN_SCOPE=https://ai.azure.com/.default

# The deployment name configured in Azure AI Foundry, not necessarily the model family name.
AZURE_OPENAI_DEPLOYMENT=YOUR_CHAT_DEPLOYMENT

# Underlying model ID, used to select compatible request parameters.
# Recommended for this project: gpt-5.4-mini.
AZURE_OPENAI_MODEL_FAMILY=gpt-5.4-mini

# v1 is recommended for current GPT-5 deployments. Use legacy only for older deployments.
AZURE_OPENAI_API_MODE=v1

# GPT-5 reasoning controls. Low is the default cost/quality balance for this agent.
AZURE_OPENAI_REASONING_EFFORT=low
AZURE_OPENAI_MAX_COMPLETION_TOKENS=8192
# Cost telemetry only. Update these when Azure pricing or contract pricing changes.
AZURE_OPENAI_INPUT_PRICE_PER_MILLION=0.75
AZURE_OPENAI_OUTPUT_PRICE_PER_MILLION=4.50

# Optional embedding deployment. Recommended model: text-embedding-3-small.
# If omitted, Hybrid RAG uses the deterministic offline feature-hash fallback.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Use the version approved for your resource/deployment. Change only when required.
AZURE_OPENAI_API_VERSION=2024-10-21

DATA_AGENT_LLM_TIMEOUT=45
DATA_AGENT_LLM_RETRIES=2

# Explicit synthetic mode for a fresh public clone. Never use demo figures as
# business results. Docker defaults to 1; real data deployments must set 0.
DATA_AGENT_DEMO_MODE=0
# Optional location for generated demo sources.
DATA_AGENT_DEMO_ROOT=

# Optional override for the second real Provider. By default the path comes from
# config/sources.yaml and resolves under DATA_AGENT_DATA_ROOT.
DATA_AGENT_NLU_REPORT=
